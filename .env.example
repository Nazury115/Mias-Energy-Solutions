# Copy to .env.local (never committed) and change values as needed. Every variable is optional for local development.

# Signs contact-form tokens and hashes network addresses. Required in production; development uses a built-in value.
MIAS_FORM_SECRET=

# Signs sign-in sessions and tokens (Better Auth). Required in production; development uses a built-in value.
BETTER_AUTH_SECRET=

# Where the local PostgreSQL (PGlite) database lives. Default: .data/pglite inside the project.
# MIAS_DB_DIR=
# Optional separate Next.js build directory for an isolated verification server.
# MIAS_BUILD_DIR=.next-verification

# Email delivery for inquiry notifications. "dev-inbox" keeps everything on this computer (see /dev/inbox).
# A real email service is added at launch (increment 012).
# MIAS_EMAIL_TRANSPORT=dev-inbox

# MIAS_INQUIRY_RECIPIENT=imasauso@gmail.com

# Spam and rate-limit settings (defaults shown).
# MIAS_MIN_FILL_MS=3000
# MIAS_LIMIT_PER_NETWORK_HOURLY=5
# MIAS_LIMIT_PER_CONTACT_DAILY=3
# Production uses one shared network bucket by default. Enable only if the origin accepts
# connections exclusively from a trusted proxy that overwrites X-Real-IP with the client IP.
# MIAS_TRUST_PROXY=true

# Absolute site address for share links, sitemap and structured data, once a domain exists.
# MIAS_SITE_URL=https://example.com

# Hides sample/fictional content for a public-ready build.
# MIAS_PUBLIC_LAUNCH=true
